# ── Kafka ──────────────────────────────────────────────────────────────────
# Generator runs locally → connects to localhost:9092
# Spark (later, in Docker) will use kafka:29092
KAFKA_BOOTSTRAP=localhost:9092
TOPIC=mfs.transactions

# ── Generator rate ─────────────────────────────────────────────────────────
# Increase for load testing. At very high rates (>500/s) run multiple
# generator instances in parallel.
EVENTS_PER_SECOND=20

# ── Injection rates (0.0 – 1.0) ────────────────────────────────────────────
DUPLICATE_RATE=0.02
LATE_RATE=0.03
MALFORMED_RATE=0.01

# ── Fraud patterns ─────────────────────────────────────────────────────────
# Set to false to disable all fraud injection (cleaner data for batch testing)
FRAUD_ENABLED=true

# ── Reproducibility ────────────────────────────────────────────────────────
# Same seed → same transaction sequence (amounts, types, wallets, injection).
# Change for load tests so each run produces a different stream.
SEED=42

# ── Run control ────────────────────────────────────────────────────────────
# Stop after N messages. 0 = run forever.
MAX_MESSAGES=0

# How often to print a stats line.
LOG_EVERY=500

# ── PostgreSQL Data Warehouse ───────────────────────────────────────────────
# Used by bronze_to_silver.py (JDBC) and Airflow PostgresOperator.
# Inside Docker the host is postgres-dw; from the host machine use localhost.
PG_URL=jdbc:postgresql://postgres-dw:5432/mfs_dw
PG_USER=mfs
PG_PASSWORD=mfs

# ── Airflow ─────────────────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=mfs-dev-secret-change-in-prod
